<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Passkey-enabled entitlements. Identical to Yggdrasil.entitlements PLUS the
  managed `com.apple.developer.web-browser.public-key-credential` capability,
  which is what lets WKWebView do WebAuthn / passkeys for github.com inside the
  embedded panel.

  NOT used by the default (ad-hoc) build — ad-hoc signing rejects this
  entitlement ("requires signing with a development certificate"). The project
  owner switches to this file ONLY after Apple approves the capability for the
  App ID and a matching provisioning profile exists. See RELEASE.md
  "Passkeys in the embedded panel (managed entitlement)".
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<false/>
	<key>com.apple.developer.web-browser.public-key-credential</key>
	<true/>
</dict>
</plist>
