# Worktrees (per CLAUDE.md convention)
.worktrees/

# Pinned lint/format tool binaries (downloaded by the Makefile)
.tools/

# macOS
.DS_Store
*.swp

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcscheme
!*.xcodeproj/xcshareddata/xcschemes/*.xcscheme

# Swift Package Manager
.swiftpm/
.build/
Packages/
# Note: do NOT ignore Package.resolved — for an Xcode app we commit the resolved
# manifest at Yggdrasil.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# so CI builds against pinned versions.

# Yggdrasil runtime data
~/Library/Application Support/Yggdrasil/

# Logs
*.log
default.profraw

# JetBrains IDE
.idea/
