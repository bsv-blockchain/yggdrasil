# Worktrees (per CLAUDE.md convention)
.worktrees/

# macOS
.DS_Store
*.swp

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcscheme
!*.xcodeproj/xcshareddata/xcschemes/*.xcscheme

# Swift Package Manager
.swiftpm/
.build/
Packages/
# Note: do NOT ignore Package.resolved — for an Xcode app we commit the resolved
# manifest at Loom.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# so CI builds against pinned versions.

# Loom runtime data
~/Library/Application Support/Loom/

# Logs
*.log
